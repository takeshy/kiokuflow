# Public app domain. GEMIHUB_MAIN_DOMAIN and GEMIHUB_OKF_* remain accepted for existing deployments.
KIOKUFLOW_MAIN_DOMAIN=kiokuflow.net
# Enable only after users have pushed/exported edits cached on the old origin.
#KIOKUFLOW_REDIRECT_LEGACY_UI=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
# Temporary, server-only credentials for copying an existing GemiHub workspace.
# Keep these references on the legacy secrets; do not overwrite GemiHub's credentials.
#GOOGLE_MIGRATION_CLIENT_ID=
#GOOGLE_MIGRATION_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8132/auth/google/callback
SESSION_SECRET=
# Standalone servers default to local mode, including when ADC is installed.
# Local mode grants Premium personal features without Firestore. Cloud Run and
# servers with GCE_METADATA_HOST/IP default to hosted mode. Override explicitly:
#KIOKUFLOW_RUNTIME=local
# Local RAG metadata and Float32 vectors; persist this directory across restarts.
#LOCAL_RAG_DIR=data/rag
# Optional GitHub PAT used only by the server for Agent Plugins API requests.
AGENT_PLUGINS_GITHUB_TOKEN=
# Preferred: private Cloud Storage bucket read with application credentials.
KIOKUFLOW_OKF_BUCKET=
KIOKUFLOW_OKF_PREFIX=
# Self-hosted fallback: public HTTPS prefix containing the same objects.
KIOKUFLOW_OKF_BASE_URL=
# Hosted mode only: Hubwork features need Google Cloud credentials for Firestore.
# Use KIOKUFLOW_RUNTIME=hosted outside Cloud Run/metadata-configured servers.
# Credentials alone never enable Firestore in local mode. Public sites,
# organizations, Vertex AI, schedules and Kakeratta Timeline sync are hosted only.
#FIRESTORE_DATABASE_ID=
# Organizations (multi-tenant orgs/projects). Hosted mode only.
# Comma-separated emails allowed to create organizations from /admin/enterprise.
#SUPER_ADMIN_EMAILS=
# GCP project for Firestore/GCS/Vertex (defaults to ADC project when unset).
#GCP_PROJECT_ID=
# Shared tenant bucket for org project files (per-project prefixes inside).
#GCS_BUCKET_NAME=
# Default region for new org tenants (bucket + Vertex AI location).
#DEFAULT_TENANT_REGION=asia-northeast1
# Vertex AI (org project mounts). ADC is the default auth; the vars below are
# only needed for per-org OAuth binding and cost estimation overrides.
#VERTEX_OAUTH_REDIRECT_URI=
# Secret used to encrypt per-org Vertex OAuth credentials at rest.
#ORG_VERTEX_OAUTH_SECRET=
# JSON map of per-model Vertex pricing overrides for budget estimation.
#VERTEX_AI_PRICING_JSON=
# Firestore vector RAG (org projects). Requires the ragChunks composite
# vector index (orgId, projectId, settingName, embedding 2048 dims).
#RAG_EMBEDDING_MODEL=gemini-embedding-2
#RAG_EMBEDDING_LOCATION=
# Secret for signing Hubwork published-site login tokens.
#HUBWORK_OAUTH_TOKEN_SECRET=

# Bluesky OAuth: public HTTPS origin (falls back to GOOGLE_REDIRECT_URI origin;
# not needed for http://localhost or http://127.0.0.1).
BLUESKY_PUBLIC_URL=
# Optional separate encryption key; defaults to SESSION_SECRET.
BLUESKY_STORAGE_SECRET=
# Local single-server fallback storage when Firestore is unavailable.
BLUESKY_STATE_DIR=
